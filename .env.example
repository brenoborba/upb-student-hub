# Copy this file to .env and fill in your UPB credentials:
#   cp .env.example .env

UPB_USERNAME=
UPB_PASSWORD=

# Base URL of the Sakai instance (leave as-is unless the domain changes)
UPB_BASE_URL=https://virtual.ipb.pt

# Google Calendar live sync (optional, only needed for --sync-calendar)
# Path to the OAuth 2.0 client secrets file downloaded from Google Cloud Console.
UPB_GCAL_CREDENTIALS=credentials.json
# Where the refresh token is stored after the first authorization.
UPB_GCAL_TOKEN=token.json
# Optional: sync into a specific calendar ID instead of the named calendar.
UPB_GCAL_CALENDAR_ID=
# Name of the dedicated calendar to create/use (default: IPB.Virtual).
UPB_GCAL_CALENDAR_NAME=IPB.Virtual
